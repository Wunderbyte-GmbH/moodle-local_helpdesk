{{!
    @template local_helpdesk/seedfirstlevel_report

    The support courses and who filling the first level support from course rights would add.

    Context variables required for this template:
    * rows The courses: courseurl, coursename (formatted HTML), assigned, eligible, toadd and names (may be empty).

    Example context (json):
    {
        "rows": [
            {
                "courseurl": "https://example.com/course/view.php?id=4",
                "coursename": "Support school A",
                "assigned": 1,
                "eligible": 3,
                "toadd": 2,
                "names": "Ann Teacher, Ben Teacher"
            },
            {
                "courseurl": "https://example.com/course/view.php?id=5",
                "coursename": "Support school B",
                "assigned": 2,
                "eligible": 2,
                "toadd": 0,
                "names": ""
            }
        ]
    }
}}
<table class="generaltable" id="local_helpdesk_seedfirstlevel">
    <thead>
        <tr>
            <th scope="col">{{#str}} course, core {{/str}}</th>
            <th scope="col">{{#str}} seedfirstlevel:assigned, local_helpdesk {{/str}}</th>
            <th scope="col">{{#str}} seedfirstlevel:eligible, local_helpdesk {{/str}}</th>
            <th scope="col">{{#str}} seedfirstlevel:toadd, local_helpdesk {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td><a href="{{courseurl}}">{{{coursename}}}</a></td>
                <td>{{assigned}}</td>
                <td>{{eligible}}</td>
                <td>{{toadd}}{{#names}} ({{names}}){{/names}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
