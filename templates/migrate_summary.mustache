{{!
    @template local_helpdesk/migrate_summary

    What a migration from local_edusupport takes over.

    Context variables required for this template:
    * rows The kinds of data: label and count.

    Example context (json):
    {
        "rows": [
            {
                "label": "Support forums",
                "count": 2
            },
            {
                "label": "Issues",
                "count": 140
            }
        ]
    }
}}
<table class="generaltable" id="local_helpdesk_migrate_summary">
    <thead>
        <tr>
            <th scope="col">{{#str}} migrate:what, local_helpdesk {{/str}}</th>
            <th scope="col">{{#str}} migrate:records, local_helpdesk {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td>{{label}}</td>
                <td>{{count}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
