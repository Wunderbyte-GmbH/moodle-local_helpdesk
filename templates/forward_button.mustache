{{!
    @template local_helpdesk/forward_button

    The button next to the title of a discussion that forwards it to the platform support team,
    or takes it back from there.

    Context variables required for this template:
    * discussionid The discussion.
    * revoke Whether the button takes the issue back.

    Example context (json):
    {
        "discussionid": 12,
        "revoke": false
    }
}}
<a href="#" class="btn btn-secondary mx-2 text-nowrap" data-action="local_helpdesk-forward"
    data-discussionid="{{discussionid}}" data-revoke="{{#revoke}}1{{/revoke}}{{^revoke}}0{{/revoke}}">
    {{#revoke}}{{#str}} issue_revoke, local_helpdesk {{/str}}{{/revoke}}
    {{^revoke}}{{#str}} issue_assign_nextlevel, local_helpdesk {{/str}}{{/revoke}}
</a>
