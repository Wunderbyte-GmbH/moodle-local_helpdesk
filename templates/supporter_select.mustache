{{!
    @template local_helpdesk/supporter_select

    The list a supporter picks who takes an issue from, grouped by support level.

    Context variables required for this template:
    * groups The support levels: label and supporters (userid, fullname, selected).

    Example context (json):
    {
        "groups": [
            {
                "label": "Platform support team",
                "supporters": [
                    {
                        "userid": 2,
                        "fullname": "Ada Admin",
                        "selected": true
                    },
                    {
                        "userid": 3,
                        "fullname": "Sam Support",
                        "selected": false
                    }
                ]
            }
        ]
    }
}}
<label class="visually-hidden sr-only" for="local_helpdesk_supporter_select">{{#str}} select, core {{/str}}</label>
<select id="local_helpdesk_supporter_select" class="form-select custom-select" data-region="local_helpdesk-supporter">
    {{#groups}}
        <optgroup label="{{label}}">
            {{#supporters}}
                <option value="{{userid}}"{{#selected}} selected{{/selected}}>{{fullname}}</option>
            {{/supporters}}
        </optgroup>
    {{/groups}}
</select>
