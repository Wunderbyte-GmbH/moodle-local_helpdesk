{{!
    @template local_helpdesk/reply_button

    The reply link of a post on the issue page, which keeps the reply inside the helpdesk.

    Context variables required for this template:
    * postid The post replied to.
    * url Where the reply is written.

    Example context (json):
    {
        "postid": 34,
        "url": "https://example.com/local/helpdesk/issue.php?discussion=12&replyto=34#mformforum"
    }
}}
<a href="{{url}}" class="btn btn-link reply-{{postid}}" data-region="post-action">{{#str}} reply, forum {{/str}}</a>
