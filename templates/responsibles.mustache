{{!
    @template local_helpdesk/responsibles

    The people who look after a request, shown to the person who filed it.

    Context variables required for this template:
    * responsibles The people: name, and either profileurl or mailto, or neither.

    Example context (json):
    {
        "responsibles": [
            {
                "name": "Sam Support",
                "profileurl": "https://example.com/user/view.php?id=3"
            },
            {
                "name": "Help desk",
                "mailto": "mailto:help@example.com"
            },
            {
                "name": "Platform support team"
            }
        ]
    }
}}
<ul class="helpdesk_responsible">
    {{#responsibles}}
        <li>
            {{#profileurl}}<a href="{{profileurl}}" target="_blank">{{name}}</a>{{/profileurl}}
            {{^profileurl}}
                {{#mailto}}<a href="{{mailto}}">{{name}}</a>{{/mailto}}
                {{^mailto}}{{name}}{{/mailto}}
            {{/profileurl}}
        </li>
    {{/responsibles}}
</ul>
