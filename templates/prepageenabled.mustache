{{!
    @template local_helpdesk/prepageenabled

    A page shown before the support form, with buttons to switch between the two.

    Context variables required for this template:
    * prepage The text of the page, as HTML.
    * form The support form, as HTML.

    Example context (json):
    {
        "prepage": "<p>Please check the FAQ first.</p>",
        "form": "<form method=\"post\" action=\"#\"><p>The support form</p></form>"
    }
}}
<div data-region="local_helpdesk-prepagecontainer">
    <div id="helpdesk-prepage" data-region="local_helpdesk-prepage">
        {{{prepage}}}
        <a href="#" role="button" class="btn btn-primary mt-2" data-action="local_helpdesk-toggleprepage">{{#str}} continue {{/str}}</a>
    </div>
    <div id="helpdesk-form" class="d-none" data-region="local_helpdesk-form">
        {{{form}}}
        <a href="#" role="button" class="btn btn-secondary" data-action="local_helpdesk-toggleprepage">{{#str}} back {{/str}}</a>
    </div>
</div>
