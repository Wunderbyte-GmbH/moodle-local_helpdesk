{{!
    @template local_helpdesk/spinner

    The spinner that covers the page while the support form is fetched.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div id="helpdesk-spinner" class="spinner-grid show" role="status">
    <div></div><div></div><div></div><div></div>
    <span class="visually-hidden sr-only">{{#str}} loading, core {{/str}}</span>
</div>
