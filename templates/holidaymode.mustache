{{!
    @template local_helpdesk/holidaymode

    Shows when a supporter is away, or a dialogue to say until when they will be.

    Context variables required for this template:
    * holidaymode Until when the supporter is away, as timestamp, or 0.
    * wwwroot The address of the site.
    * sesskey The session key.
    * uniqid An id that is unique on the page.
    * holidayform The form to set the date, as HTML.

    Example context (json):
    {
        "holidaymode": 0,
        "wwwroot": "https://example.com",
        "sesskey": "abc123",
        "uniqid": "holiday1",
        "holidayform": "<form method=\"post\" action=\"#\"><div id=\"fitem_id_holidaymode\"><label for=\"id_holidaymode\">Away until</label> <input type=\"date\" id=\"id_holidaymode\" name=\"holidaymode\"></div></form>"
    }
}}
<div class="local_helpdesk_holidaymode">
    {{#holidaymode}}
        <div class="fitem row">
            <div class="col-md-6">
                {{#str}} holidaymode_is_on, local_helpdesk {{/str}}:
                {{#userdate}} {{holidaymode}}, %d. %B %Y, %H:%M{{/userdate}}
            </div>
        </div>
        <div>
            <i>{{#str}} holidaymode_is_on_descr, local_helpdesk {{/str}}</i>
            <a href="{{wwwroot}}/local/helpdesk/issues.php?holidaymodeend=1&amp;sesskey={{sesskey}}" class="btn btn-primary btn-block d-block w-100">
                <i class="fa fa-hourglass-end"></i>
                {{#str}} holidaymode_end, local_helpdesk {{/str}}
            </a>
        </div>
    {{/holidaymode}}
    {{^holidaymode}}
        <div style="float: right;">
            <a href="#" data-holidaymode="show">
                <i class="fa fa-plane"></i>
                {{#str}} holidaymode, local_helpdesk {{/str}}
            </a>
        </div>

        <div class="modal moodle-has-zindex" data-region="modal-container" role="dialog"
            id="holidaymode-{{uniqid}}" style="display: none;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header " data-region="header">
                        <h5 class="modal-title" data-region="title">
                            {{#str}} holidaymode, local_helpdesk {{/str}}
                        </h5>
                        <a href="#" class="btn close btn-close" data-holidaymode="hide"
                             aria-label={{#quote}}{{#str}}closebuttontitle{{/str}}{{/quote}}>
                            <span aria-hidden="true">×</span>
                        </a>
                    </div>
                    <div class="modal-body" data-region="body">
                        {{{holidayform}}}
                    </div>
                    <div class="modal-footer" data-region="footer">
                        <button type="button" class="btn btn-primary" data-holidaymode="save">
                            {{#str}} savechanges {{/str}}
                        </button>
                        <button type="button" class="btn btn-secondary" data-holidaymode="hide">
                            {{#str}} cancel {{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {{/holidaymode}}
</div>
{{#js}}
(function() {
    var dialogue = document.getElementById('holidaymode-{{uniqid}}');
    if (!dialogue) {
        return;
    }
    dialogue.parentNode.addEventListener('click', function(e) {
        var target = e.target.closest('[data-holidaymode]');
        if (!target) {
            return;
        }
        e.preventDefault();
        if (target.dataset.holidaymode === 'save') {
            dialogue.querySelector('form').submit();
        } else {
            dialogue.style.display = target.dataset.holidaymode === 'show' ? 'block' : 'none';
        }
    });
})();
{{/js}}
